# ==============================================================================
# SMART WEBRTC CLASSROOM - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env on your backend hosting platform (Render, Railway, Fly.io, VPS)
# DO NOT commit your real .env file with private secrets to GitHub!

# --- Server Network Configuration ---
# Port provided automatically by Render/Railway or custom port (defaults to 3000)
PORT=3000
HOST=0.0.0.0

# --- Security & Origin Verification ---
# Comma-separated list of allowed frontend origins (GitHub Pages domain, localhost)
# Example: https://yourusername.github.io,http://localhost:3000
ALLOWED_ORIGINS=https://yourusername.github.io,http://localhost:3000

# Secret key used for signing teacher session tokens (generate a long random string)
SESSION_SECRET=change_this_to_a_long_random_cryptographic_secret_key_in_production

# Require teacher authentication to create classrooms (true / false)
REQUIRE_TEACHER_AUTH=true

# Optional: Default Administrator Teacher Account (auto-created on server boot if set)
DEFAULT_TEACHER_USER=admin_professor
DEFAULT_TEACHER_PASS=AmritaSecure2026!
DEFAULT_TEACHER_NAME=Professor Sharma

# Maximum spectator students allowed per classroom session
MAX_STUDENTS_PER_ROOM=150

# --- WebRTC STUN & TURN Traversal Configuration ---
# Public STUN servers for NAT discovery (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional: Dedicated TURN Server credentials for restrictive firewalls / symmetric NAT
# (e.g. from Metered.ca, Twilio, Coturn, or Xirsys)
TURN_URL=turn:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
